# Spring Boot
SPRING_DATASOURCE_URL=jdbc:mysql://database:3306/teojaba?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=teojaba
SPRING_DATASOURCE_PASSWORD=teojaba1234

# Kakao Map API
